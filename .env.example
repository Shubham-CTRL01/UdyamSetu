# ============================================================
# UdyamSetu — Environment Configuration Template
# ============================================================
# Copy this file to `.env.local` and replace the placeholder values
# with your actual Supabase project credentials.
#
# DO NOT commit `.env.local` or `.env` with real credentials to GitHub.
# ============================================================

# Supabase Project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
